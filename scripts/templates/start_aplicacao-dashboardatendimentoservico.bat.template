@echo off
setlocal
cd /d "%~dp0"

set "JAVA_HOME=C:\Desenvolvimento\jdk-17.0.11"
set "MAVEN_HOME=C:\Desenvolvimento\apache-maven-3.8.8"
set "PATH=%JAVA_HOME%\bin;%MAVEN_HOME%\bin;%PATH%"

set "POSTGRES_HOST={{POSTGRES_HOST}}"
set "POSTGRES_PORT={{POSTGRES_PORT}}"
set "POSTGRES_DB={{POSTGRES_DB}}"
set "POSTGRESQL_USERNAME={{POSTGRES_USER}}"
set "POSTGRESQL_PASSWORD={{POSTGRES_PASSWORD}}"
set "POSTGRESQL_JDBC_URL=jdbc:postgresql://%POSTGRES_HOST%:%POSTGRES_PORT%/%POSTGRES_DB%"
set "OIDC_AUTH_SERVER_URL={{OIDC_AUTH_SERVER_URL}}"
set "OIDC_CLIENT_ID={{OIDC_CLIENT_ID}}"
set "OIDC_CLIENT_SECRET={{OIDC_CLIENT_SECRET}}"
set "CORS_ALLOWED_ORIGINS=http://localhost:3000"
set "SESSION_COOKIE_SECURE=false"

"%JAVA_HOME%\bin\java.exe" -version
call docker compose up -d
if errorlevel 1 exit /b %errorlevel%

call mvn quarkus:dev
set "RESULTADO=%errorlevel%"
pause
endlocal & exit /b %RESULTADO%
